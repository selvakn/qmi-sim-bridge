#!/bin/sh /etc/rc.common
# procd service for qmi-sim-bridge. Install as /etc/init.d/qmi-sim-bridge.
# Options come from uci: qmi-sim-bridge.main.{at,qmi,link,slot,aid,trace,vpcd}
# Setting vpcd (host:port) selects PC/SC mode; at/link are then unused.

START=96
STOP=10
USE_PROCD=1
PROG=/usr/sbin/qmi-sim-bridge

start_service() {
	config_load qmi-sim-bridge
	local enabled at qmi link slot aid trace vpcd
	config_get_bool enabled main enabled 1
	[ "$enabled" = 1 ] || return 0
	config_get at main at /dev/wwan0at1
	config_get qmi main qmi /dev/wwan0qmi0
	config_get link main link /dev/ttyUSB3
	config_get slot main slot 1
	config_get aid main aid
	config_get_bool trace main trace 0
	config_get vpcd main vpcd

	procd_open_instance
	if [ -n "$vpcd" ]; then
		# PC/SC mode: be the card behind pcscd's vpcd reader; no pty, no AT.
		procd_set_param command "$PROG" --vpcd "$vpcd" --qmi "$qmi" --slot "$slot"
	else
		procd_set_param command "$PROG" --at "$at" --qmi "$qmi" --link "$link" --slot "$slot"
	fi
	[ -n "$aid" ] && procd_append_param command --aid "$aid"
	[ "$trace" = 1 ] && procd_append_param command --trace
	# The AT/QMI ports vanish while the modem restarts; keep retrying.
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
