#!/bin/sh /etc/rc.common
# Bring up every compose app under /apps at boot (podman has no
# restart-policy daemon here). Runs after podman's API service (S99podman).

START=99
STOP=05

COMPOSE_HOST=unix:///run/podman/podman.sock

wait_socket() {
	local i=0
	while [ ! -S /run/podman/podman.sock ] && [ $i -lt 30 ]; do
		sleep 1; i=$((i + 1))
	done
}

start() {
	wait_socket
	for f in /apps/*/docker-compose.yml; do
		[ -f "$f" ] || continue
		( cd "${f%/*}" && DOCKER_HOST=$COMPOSE_HOST docker-compose up -d ) 2>&1 \
			| logger -t podman-apps
	done
}

stop() {
	for f in /apps/*/docker-compose.yml; do
		[ -f "$f" ] || continue
		( cd "${f%/*}" && DOCKER_HOST=$COMPOSE_HOST docker-compose stop -t 90 ) 2>&1 \
			| logger -t podman-apps
	done
}
