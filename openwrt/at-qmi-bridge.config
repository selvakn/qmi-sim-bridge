config bridge 'main'
	option enabled '1'
	option at '/dev/wwan0at1'
	option qmi '/dev/wwan0qmi0'
	option link '/dev/ttyUSB3'
	option slot '1'
	# option aid 'A0000000871002FFF605FF89000001FF'
	# PC/SC mode: be the card behind pcscd's "QMI SIM" vpcd reader instead of
	# serving a pty (no AT port is used). Pair with a pcsc_reader line in
	# gsm-sip-bridge's config.toml.
	# option vpcd '127.0.0.1:15963'
