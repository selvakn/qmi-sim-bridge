#!/bin/sh /etc/rc.common
# gsm-sip-bridge as a plain process (no podman), from the image's root
# filesystem unpacked at $ROOT:
#   C=$(podman create ghcr.io/selvakn/gsm-sip-bridge:<tag>)
#   podman export $C | tar -x -C /overlay/gsm-sip-bridge-root; podman rm $C
# App files (config.toml, .env, data/, fake-usb/, prestart) stay in $APP.

START=99
STOP=05
USE_PROCD=1

ROOT=/overlay/gsm-sip-bridge-root
APP=/apps/gsm-sip-bridge

# Absolute paths the binary (and charon/pcscd) hard-code; none exist on
# OpenWrt, so they are symlinked into the unpacked image.
LINKS="/usr/libexec/ipsec /usr/lib/ipsec /usr/lib/pcsc /usr/sbin/swanctl /usr/sbin/pcscd
	/etc/strongswan.d /etc/strongswan.conf /etc/swanctl /etc/reader.conf.d
	/etc/gsm-sip-bridge /usr/local/bin/gsm-sip-bridge"

# The image's symlinks are absolute (e.g. timeout -> /bin/busybox). Outside a
# chroot they would resolve to the host's busybox, which lacks applets such as
# `timeout`, so point them back into $ROOT (idempotent).
relink_root() {
	local l t
	find "$ROOT" -type l | while read -r l; do
		t=$(readlink "$l")
		case "$t" in
			"$ROOT"/*) ;;
			/*) ln -sfn "$ROOT$t" "$l" ;;
		esac
	done
}

# charon runs the updown script without our PATH/LD_LIBRARY_PATH, and its
# `ip netns exec … ip addr add` then failed silently (the tunnel address never
# appeared, so IMS registration got "Host is unreachable"). Pin the image's
# userland in the script and log ip errors instead of discarding them.
patch_updown() {
	local u="$ROOT/etc/strongswan.d/ims.updown"
	grep -q "at-qmi-bridge native" "$u" && return 0
	[ -f "$u.orig" ] || cp "$u" "$u.orig"
	sed -i "2i # at-qmi-bridge native deployment: charon passes no usable PATH; pin the image userland.\nPATH=$ROOT/usr/sbin:$ROOT/usr/bin:$ROOT/sbin:$ROOT/bin:/usr/sbin:/usr/bin:/sbin:/bin\nLD_LIBRARY_PATH=$ROOT/usr/lib:$ROOT/lib\nexport PATH LD_LIBRARY_PATH" "$u"
	sed -i 's| 2>/dev/null \|\| true| 2>\&1 \| logger -t ims.updown \|\| true|' "$u"
}

prepare() {
	local p
	[ -f "$ROOT/.relinked" ] || { relink_root && touch "$ROOT/.relinked"; }
	patch_updown
	for p in $LINKS; do
		[ -e "$p" ] || [ -L "$p" ] || { mkdir -p "${p%/*}"; ln -s "$ROOT$p" "$p"; }
	done
	# charon runs updown scripts with an empty environment, so their
	# `ip netns exec … ip …` searches only /bin:/usr/bin; OpenWrt has ip in /sbin.
	[ -e /usr/bin/ip ] || ln -s /sbin/ip /usr/bin/ip
	mkdir -p /var/lib/gsm-sip-bridge "$APP/data"
	# gsm-sip-bridge discovers modems only by walking USB sysfs for Quectel
	# IDs; the stick is a USB gadget, so this directory is otherwise empty.
	grep -q " /sys/bus/usb/devices " /proc/mounts ||
		mount -o bind,ro "$APP/fake-usb" /sys/bus/usb/devices
}

start_service() {
	prepare
	procd_open_instance
	procd_set_param command "$APP/run-native"
	procd_set_param env ROOT="$ROOT" APP="$APP"
	procd_set_param respawn 3600 10 0
	# supervise's teardown budget is 60 s (see upstream docker-compose).
	procd_set_param term_timeout 90
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
